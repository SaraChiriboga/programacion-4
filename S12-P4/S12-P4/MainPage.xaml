<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="S12_P4.MainPage"
             Title="Superheroes">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label Text="Superheroes"
           FontSize="28"
           FontAttributes="Bold"
           HorizontalOptions="Center"/>

            <CollectionView ItemsSource="{Binding Heroes}"
                    SelectedItem="{Binding SelectedHero, Mode = TwoWay}"
                    SelectionMode="Single">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="10" ColumnDefinitions="100, *">
                            <Image Source="{Binding Image}" WidthRequest="80" HeightRequest="80" Aspect="AspectFill"/>
                            <VerticalStackLayout Grid.Column="1" Padding="10.0">
                                <Label Text="{Binding Name}" FontSize="20" FontAttributes="Bold"/>
                                <Label Text="{Binding Power}" FontSize="14" TextColor="Aqua" LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Frame BorderColor="green" CornerRadius="14" Padding="12">
                <VerticalStackLayout>
                    <Label Text="Heroe Seleccionado" FontAttributes="Bold"/>
                    <Label Text="{Binding SelectedHero.Name}" FontSize="16"/>
                    <Label Text="{Binding SelectedHero.Power}" FontSize="14" TextColor="Firebrick"/>
                </VerticalStackLayout>
            </Frame>

            <Button Text="Ver Detalle" Command="{Binding ShowHeroCommand}"
            HeightRequest="45"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
