<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="S14_P4.RegistroPage"
    Title="Registro de Medicamento">

    <VerticalStackLayout Padding="20" Spacing="10">
        <Entry x:Name="nombreEntry" Placeholder="Nombre del medicamento"/>
        <Entry x:Name="precioEntry" Placeholder="Precio" Keyboard="Numeric"/>
        <Entry x:Name="stockEntry" Placeholder="Stock" Keyboard="Numeric"/>

        <Button x:Name="btnGuardar"
                Text="Guardar"
                Clicked="OnGuardarClicked"/>
    </VerticalStackLayout>

</ContentPage>