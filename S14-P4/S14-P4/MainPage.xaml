<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="S14_P4.MainPage">

    <VerticalStackLayout Padding="20" Spacing="10">

        <Button Text="Agregar Medicamento"
                Clicked="OnAgregarClicked"/>

        <CollectionView x:Name="medicamentosView">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="10" Margin="5">
                        <VerticalStackLayout>
                            <Label Text="{Binding Nombre}" FontAttributes="Bold"/>
                            <Label Text="{Binding Precio, StringFormat='Precio: {0:C}'}"/>
                            <Label Text="{Binding Stock, StringFormat='Stock: {0}'}"/>

                            <Button Text="Editar"
                                    Clicked="OnEditarClicked"
                                    CommandParameter="{Binding .}"/>
                            <Button Text="Eliminar"
                                    Clicked="OnEliminarClicked"
                                    CommandParameter="{Binding .}"/>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>